# Local dev uses SQLite (file:./testtime.db) via prisma/schema.prisma.
# For hosted deploys, set DATABASE_URL to a PostgreSQL connection string
# (the deploy pipeline uses prisma/schema.postgres.prisma).
DATABASE_URL="file:./testtime.db"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRATION="7d"
PORT=4000

# Comma-separated list of allowed frontend origins (CORS).
# Local: http://localhost:3000 | Live: your Vercel URL.
CORS_ORIGINS="http://localhost:3000"
