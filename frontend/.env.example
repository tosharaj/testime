# Base URL of the deployed NestJS backend (e.g. https://testtime-api.onrender.com).
# When empty, the frontend uses the local Next.js /api proxy -> http://localhost:4000.
NEXT_PUBLIC_API_URL=

# Backend target for the Next.js /api rewrite (server-side proxy).
# Default: http://localhost:4000 locally; https://testtime-api.onrender.com on Vercel.
BACKEND_URL=

# Supabase (used for admin + user auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
